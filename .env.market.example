# market-web / market-cron に渡す env（docker-compose.market.yml の env_file）。
# 値の一覧と既定は documents/Specification.md §12、テンプレートは .env.example。
# ここはコンテナで**物理的に必要な差分**だけを書く。

SECRET_KEY=change-me
DEBUG=0
DJANGO_ALLOWED_HOSTS=spv.buxbit.net localhost 127.0.0.1
ADMIN_URL=market/admin/

# DB は専用コンテナ（SQL_HOST / SQL_PORT は compose 側で指定済み）
SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=yp_market
SQL_USER=yp_market_user
SQL_PASSWORD=change-me

# BE への唯一の結線（§7 のイントロスペクション先。コードに IP を書かない）。
# ⚠ 実際に使い始めるのは Phase 1。market は betawallet のネットワークに入って
#    いないので、そのときに経路を決める（BE のコンテナ名で引けるように
#    ネットワークを 1 本足すか、ホスト側の入口を指すか）。決めるまで空でよい。
BE_API_BASE_URL=

MARKET_ENV=prod
MARKET_DEV_PRINCIPALS=

CSRF_TRUSTED_ORIGINS=https://spv.buxbit.net
STATIC_URL=/market-static/
STATIC_ROOT=/home/app/web/market-static
