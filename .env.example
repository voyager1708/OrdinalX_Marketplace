# OrdinalX Marketplace — 環境変数のテンプレート（プレースホルダのみ）
#
# 一覧と既定値は documents/Specification.md §12。秘密はこのファイルに書かず、
# 各環境の .env（git 管理外）に置く。.env の後に env.local があれば上書きされる。

# --- コア ---
SECRET_KEY=change-me
DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1 localhost
# admin の露出先。nginx 側でも遮断する（§7）
ADMIN_URL=market/admin/

# --- DB（§2: 専用 DB。yp_dev_db は共有しない）---
SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=yp_market_dev
SQL_USER=yp_market_user
SQL_PASSWORD=change-me
SQL_HOST=127.0.0.1
SQL_PORT=5432

# --- vault（別プロセス・別 DB・別鍵。§4・§14-13）---
# 変数名を market と共有しない（取り違えると鍵が帳簿 DB に入る）
VAULT_SECRET_KEY=change-me
VAULT_SQL_ENGINE=django.db.backends.sqlite3
VAULT_SQL_DATABASE=
VAULT_SQL_USER=
VAULT_SQL_PASSWORD=
VAULT_SQL_HOST=
VAULT_SQL_PORT=
# CK を封じるマスター鍵は env だけから。コードにも DB にも置かない
VAULT_MASTER_KEY_ID=
VAULT_MASTER_KEY=

# --- BE への唯一の結線（§7・§13.4-5）---
# docker のネットワーク名・コンテナ名・IP をコードに書かない
BE_API_BASE_URL=http://127.0.0.1:8002

# --- 環境分離（§13.3）---
MARKET_ENV=dev
# dev の作成・出品を許す principal（BE の user id）を空白または , 区切りで
MARKET_DEV_PRINCIPALS=

# --- チェーン（§12）---
# ARC_CALLBACK_URL 未設定だと同期ポーリング 20 回で 504 になる。本番では必ず設定する
ARC_URL=
ARC_TOKEN=
ARC_CALLBACK_URL=
ARC_CALLBACK_TOKEN=
WOC_API_BASE_URL=
WOC_API_KEY=
WOC_NETWORK=main

# --- 手数料（§10）---
MARKET_FEE_BPS=250
MARKET_FEE_SCRIPT=
MARKET_FEE_POLICY_DEFAULT=creator/prepaid_bsv
# fee wallet の鍵は env だけから（コードにも DB にも埋めない）
MARKET_FEE_WALLET_WIF=
MAX_FEE_SATOSHIS_PER_WORK=5000000
MAX_SUBSIDY_SATOSHIS_PER_DAY=5000000
MAX_OUTSTANDING_PER_VENDOR=1000000

# --- 審査待ちの staging（§9.1）---
MAX_STAGING_BYTES_TOTAL=2147483648
STAGING_TTL_HOURS=72
MAX_WORKS_IN_REVIEW=10
TAKEDOWN_PROVISIONAL_SLA_HOURS=24

# --- 静的ファイル（S012 §8。ウォレットの /static/ と分ける）---
STATIC_URL=/market-static/
